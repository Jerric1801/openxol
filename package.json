{
  "name": "openxol",
  "version": "0.1.0",
  "description": "Open-source meeting intelligence — transcription, diarization, AI analysis",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build && electron-builder",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:mac:dev": "electron-vite build && electron-builder --mac --arm64",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "keywords": [
    "meeting",
    "transcription",
    "diarization",
    "whisper",
    "gemini",
    "open-source"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.6.0",
    "docx": "^8.5.0",
    "electron-log": "^5.0.1",
    "electron-store": "^10.0.0"
  }
}
