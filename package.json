{
  "name": "meeting-analysis-app",
  "version": "1.0.0",
  "description": "Standalone GUI application for meeting transcription and analysis",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "meeting",
    "transcription",
    "analysis",
    "whisper",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "docx": "^8.5.0",
    "electron-store": "^10.0.0",
    "electron-log": "^5.0.1",
    "axios": "^1.6.0"
  },
  "build": {
    "appId": "com.meetinganalysis.app",
    "productName": "Meeting Analysis",
    "directories": {
      "output": "build"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "bin",
        "to": "Resources/bin",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}

